# 실제 키는 .env 파일에 저장 (.env는 깃에 올라가지 않음)
# 이 파일을 복사해서 시작: cp .env.example .env
ANTHROPIC_API_KEY=sk-ant-...

# Analysis/Persona 등 생성 작업용 (저가 모델)
MODEL_WORKER=claude-haiku-4-5
# Judge 채점용 (더 정확한 모델)
MODEL_JUDGE=claude-sonnet-4-6

# --- 아래는 eval_pairwise.py --judge {gemini,solar,nim}용 (평가 전용, 제품 경로 미사용) ---
# --judge gemini
GOOGLE_API_KEY=
# --judge solar (Upstage)
UPSTAGE_API_KEY=
# --judge nim (NVIDIA NIM)
NVIDIA_API_KEY=
